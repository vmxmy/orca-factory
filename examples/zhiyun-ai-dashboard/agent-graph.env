# Project profile for the agent graph (sourced by agent-graph.sh and by orca-factory-driver).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
AGENT_GH_REPO=vmxmy/zhiyun-ai-dashboard
AGENT_ISSUE_BACKEND=github                                 # 唯一执行账本：本示例用 GitHub Issues（AGENT_GH_REPO 同仓库）
AGENT_MAX_IN_FLIGHT=6
AGENT_STALE_HOURS=8   # 在途票超过此时长无票据更新 -> driver 判为陈旧
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-
AGENT_INSTALL_CMD='pnpm install --frozen-lockfile && pnpm --dir web install --frozen-lockfile'
AGENT_DEPLOY_WORKFLOW='Deploy to Cloudflare'
AGENT_SMOKE_CMD='[ "$(curl -s -o /dev/null -w %{http_code} https://ai.ziikoo.com/login)" = 200 ] && [ "$(curl -s -o /dev/null -w %{http_code} https://ai.ziikoo.com/api/v1/me)" = 401 ]'
# Model tiers (agent:model:effort, resolved per workflow.md §6); lane 2 second-pass review command (empty = skip).
AGENT_TIER_DEFAULT='codex:gpt-6-astra:medium'     # agent:model:effort；model 可空（codex::low = 该 agent 默认模型）
AGENT_TIER_STRONG='codex:gpt-6.1-sol:high'
AGENT_TIER_ESCALATE=1                           # 1=被打回一次后下一轮 correction 自动升一档；0=不升
AGENT_ROLE_REVIEWER_CMD='codex exec --json'
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (PR not self-merged).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
AGENT_LANE2_GLOBS='spec/* functions/api/v1/_*-routes.js functions/api/_session.js worker.js wrangler.toml web/src/lib/types.ts registry/* functions/_greptime-read.js package.json web/package.json .github/* .claude/* .codex/* AGENTS.md CLAUDE.md scripts/agent-gates/* web/src/components/ui/* postgres-migrations/*'
AGENT_LANE3_GLOBS='.dev.vars* wrangler.toml.secrets* .github/workflows/deploy*'
