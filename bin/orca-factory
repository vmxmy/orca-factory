#!/usr/bin/env bash
# orca-factory: install / refresh / verify the agent-gates pipeline files in a target repo.
#
#   orca-factory init <repo-path>      copy core/ (incl. constitution/ and roles/) and the three project files
#                                      (from templates/, .example stripped) into <repo>/scripts/agent-gates/.
#                                      Existing project files are never overwritten. Also merges two keys into
#                                      <repo>/.claude/settings.json so Claude Code auto-installs the swarm-board mod.
#   orca-factory update <repo-path>    overwrite only the core files (incl. constitution/ roles/) in
#                                      <repo>/scripts/agent-gates/, print a diff summary. local-*.md untouched.
#   orca-factory check <repo-path>     compare the core files in <repo> with this repository (cmp). The shared
#                                      clauses constitution/{engineering,workflow,handoffs}.md must be byte-identical
#                                      (reported as OVERRIDDEN otherwise). Exit 1 on any drift.
#   orca-factory selftest              init into a temporary git repo, run gate.test.sh, check, and verify that
#                                      an edited shared clause is reported as overridden.
set -Eeuo pipefail

FACTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
CORE="$FACTORY/core"
TEMPLATES="$FACTORY/templates"
DEST_REL="scripts/agent-gates"
PROJECT_FILES=(agent-graph.env gate.project.sh COORDINATOR.project.md)
PROTECTED_CLAUSES=(constitution/engineering.md constitution/workflow.md constitution/handoffs.md)
MARKETPLACE_REPO="vmxmy/orca-factory"   # .claude-plugin/marketplace.json of this repo; the mod lives in mods/swarm-board
MOD_ID="swarm-board@orca-factory"

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }
fail() { echo "orca-factory: $*" >&2; exit 1; }

# Relative paths of every distributable core file, including constitution/ and roles/ subtrees.
core_files() { (cd "$CORE" && find . -type f | sed 's#^\./##' | sort); }

is_protected() { local f="$1" p; for p in "${PROTECTED_CLAUSES[@]}"; do [[ "$f" == "$p" ]] && return 0; done; return 1; }

resolve_repo() {
  local p="${1:-}"
  [[ -n "$p" ]] || usage
  [[ -d "$p" ]] || fail "not a directory: $p"
  cd "$p" && pwd -P
}

copy_core() {  # copy_core <dest-dir> ; overwrites
  local dest="$1" f
  mkdir -p "$dest"
  while IFS= read -r f; do
    mkdir -p "$dest/$(dirname "$f")"
    cp "$CORE/$f" "$dest/$f"
    if [[ "$f" == *.sh ]]; then chmod +x "$dest/$f"; fi
  done < <(core_files)
}

# Merge the marketplace + enabled-plugin keys into <repo>/.claude/settings.json (created if absent, other keys kept).
install_mod_settings() {
  local repo="$1" f="$1/.claude/settings.json" tmp
  mkdir -p "$repo/.claude"
  [[ -f "$f" ]] || echo '{}' > "$f"
  tmp="$(mktemp)"
  jq --arg r "$MARKETPLACE_REPO" --arg m "$MOD_ID" \
    '.extraKnownMarketplaces["orca-factory"] = {source: {source: "github", repo: $r}} | .enabledPlugins[$m] = true' "$f" > "$tmp" \
    || fail "cannot update $f"
  mv "$tmp" "$f"
  echo "init: .claude/settings.json -> marketplace orca-factory + $MOD_ID enabled (Claude Code installs it on next start)"
  if git -C "$repo" check-ignore -q .claude/settings.json 2>/dev/null; then
    echo "init: note: .claude/settings.json is gitignored in this repo, so the registration stays on this machine; add '!.claude/settings.json' to .gitignore to share it"
  fi
}
mod_enabled() { jq -e --arg m "$MOD_ID" '.enabledPlugins[$m] == true' "$1/.claude/settings.json" >/dev/null 2>&1; }

cmd_init() {
  local repo dest f src
  repo="$(resolve_repo "${1:-}")"
  dest="$repo/$DEST_REL"
  copy_core "$dest"
  install_mod_settings "$repo"
  echo "init: core -> $dest ($(core_files | wc -l | tr -d ' ') files)"
  for f in "${PROJECT_FILES[@]}"; do
    src="$TEMPLATES/$f.example"
    [[ -f "$src" ]] || fail "missing template $src"
    if [[ -e "$dest/$f" ]]; then
      echo "init: keep existing $DEST_REL/$f"
    else
      cp "$src" "$dest/$f"
      if [[ "$f" == *.sh ]]; then chmod +x "$dest/$f"; fi
      echo "init: template -> $DEST_REL/$f (fill the {{placeholders}})"
    fi
  done
  echo "init: next, follow ONBOARD.md steps 1-5 to fill the project files in $DEST_REL/"
}

cmd_update() {
  local repo dest f changed=0 added=0 same=0 n
  repo="$(resolve_repo "${1:-}")"
  dest="$repo/$DEST_REL"
  [[ -d "$dest" ]] || fail "$dest does not exist; run: orca-factory init $repo"
  while IFS= read -r f; do
    if [[ ! -e "$dest/$f" ]]; then
      added=$((added + 1)); echo "update: + $f (new)"
    elif cmp -s "$CORE/$f" "$dest/$f"; then
      same=$((same + 1))
    else
      changed=$((changed + 1))
      n="$(diff "$dest/$f" "$CORE/$f" | grep -c '^[<>]' || true)"
      if is_protected "$f"; then echo "update: ~ $f ($n lines differ; was OVERRIDDEN, restoring core version)"
      else echo "update: ~ $f ($n lines differ)"; fi
      { diff -u "$dest/$f" "$CORE/$f" || true; } | sed -n '3,40p' | sed 's/^/    /'
    fi
    mkdir -p "$dest/$(dirname "$f")"
    cp "$CORE/$f" "$dest/$f"
    if [[ "$f" == *.sh ]]; then chmod +x "$dest/$f"; fi
  done < <(core_files)
  echo "update: changed=$changed added=$added unchanged=$same; project files and local-*.md untouched (${PROJECT_FILES[*]})"
}

cmd_check() {
  local repo dest f rc=0
  repo="$(resolve_repo "${1:-}")"
  dest="$repo/$DEST_REL"
  [[ -d "$dest" ]] || fail "$dest does not exist"
  while IFS= read -r f; do
    if [[ ! -e "$dest/$f" ]]; then
      echo "check: MISSING  $f"; rc=1
    elif cmp -s "$CORE/$f" "$dest/$f"; then
      echo "check: ok       $f"
    elif is_protected "$f"; then
      # The three shared clauses are reserved names: a project may add constitution/local-*.md but never
      # ship its own engineering.md / workflow.md / handoffs.md.
      echo "check: OVERRIDDEN $f (shared clause must match core; put project rules in constitution/local-*.md)"; rc=1
    else
      echo "check: DIFFERS  $f"; rc=1
    fi
  done < <(core_files)
  for f in "${PROJECT_FILES[@]}"; do
    if [[ ! -e "$dest/$f" ]]; then
      echo "check: project file missing: $f"; rc=1
    elif grep -q '{{' "$dest/$f"; then
      echo "check: project file still has {{placeholders}}: $f"; rc=1
    fi
  done
  # Optional project overlays: constitution/local-*.md and roles/local-*.md. Only checked for leftover placeholders.
  while IFS= read -r f; do
    if grep -q '{{' "$f"; then echo "check: local file still has {{placeholders}}: ${f#"$dest/"}"; rc=1; fi
  done < <(find "$dest/constitution" "$dest/roles" -maxdepth 1 -type f -name 'local-*.md' 2>/dev/null | sort)
  if mod_enabled "$repo"; then echo "check: ok       .claude/settings.json enables $MOD_ID"
  else echo "check: MOD      $MOD_ID not enabled in .claude/settings.json (run: orca-factory init $repo)"; rc=1; fi
  (( rc == 0 )) && echo "check: core files match $FACTORY/core"
  return $rc
}

SELFTEST_TMP=""
cmd_selftest() {
  SELFTEST_TMP="$(mktemp -d "${TMPDIR:-/tmp}/orca-factory-selftest.XXXXXX")"
  trap '[[ -n "$SELFTEST_TMP" ]] && rm -rf "$SELFTEST_TMP"' EXIT
  git init -q "$SELFTEST_TMP"
  cmd_init "$SELFTEST_TMP"
  find "$SELFTEST_TMP/$DEST_REL" -type f | sed "s#^$SELFTEST_TMP/##" | sort
  for f in constitution/constitution.md "${PROTECTED_CLAUSES[@]}" roles/intake.md roles/coordinator.md roles/worker.md roles/reviewer.md roles/README.md; do
    [[ -f "$SELFTEST_TMP/$DEST_REL/$f" ]] || fail "selftest: init did not produce $f"
  done
  bash "$SELFTEST_TMP/$DEST_REL/gate.test.sh"
  # ledger: a row carrying tier must show up on a tier= line in stats (rows without tier report as unknown).
  AGENT_REPO_PATH="$SELFTEST_TMP" bash "$SELFTEST_TMP/$DEST_REL/ledger.sh" append \
    '{"ticket":"T-1","lane":1,"tier":"fast","outcome":"merged","first_gate":"green","corrections":0}'
  AGENT_REPO_PATH="$SELFTEST_TMP" bash "$SELFTEST_TMP/$DEST_REL/ledger.sh" stats > "$SELFTEST_TMP/stats.out"
  grep -q '^tier=fast runs=1 first_gate_green_pct=100$' "$SELFTEST_TMP/stats.out" || { cat "$SELFTEST_TMP/stats.out"; fail "selftest: ledger stats has no tier= line"; }
  echo "selftest: ledger stats reports tier"
  # check: fresh init must have no core drift (project files still carry placeholders, so only inspect core lines).
  cmd_check "$SELFTEST_TMP" > "$SELFTEST_TMP/check.out" || true
  grep -Eq '^check: (MISSING|DIFFERS|OVERRIDDEN)' "$SELFTEST_TMP/check.out" && { cat "$SELFTEST_TMP/check.out"; fail "selftest: core drift right after init"; }
  # check: editing a shared clause must be reported as OVERRIDDEN, and update must restore it.
  printf '\n- project override attempt\n' >> "$SELFTEST_TMP/$DEST_REL/constitution/engineering.md"
  cmd_check "$SELFTEST_TMP" > "$SELFTEST_TMP/check.out" || true
  grep -q '^check: OVERRIDDEN constitution/engineering.md' "$SELFTEST_TMP/check.out" || { cat "$SELFTEST_TMP/check.out"; fail "selftest: overridden clause not detected"; }
  echo "selftest: overridden shared clause detected"
  cmd_update "$SELFTEST_TMP" > /dev/null
  cmp -s "$CORE/constitution/engineering.md" "$SELFTEST_TMP/$DEST_REL/constitution/engineering.md" || fail "selftest: update did not restore engineering.md"
  echo "selftest: update restored shared clause"
  mod_enabled "$SELFTEST_TMP" || fail "selftest: init did not enable $MOD_ID in .claude/settings.json"
  if command -v claude >/dev/null; then
    claude plugin validate "$FACTORY/mods/swarm-board" >/dev/null || fail "selftest: mod validate failed"
    (cd "$SELFTEST_TMP" && claude plugin test "$FACTORY/mods/swarm-board" >/dev/null) || fail "selftest: mod tests failed"
    echo "selftest: mod validate + test PASS"
  fi
  echo "selftest: PASS"
}

case "${1:-}" in
  init)     cmd_init "${2:-}" ;;
  update)   cmd_update "${2:-}" ;;
  check)    cmd_check "${2:-}" ;;
  selftest) cmd_selftest ;;
  *)        usage ;;
esac
