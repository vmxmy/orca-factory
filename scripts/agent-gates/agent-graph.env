# Project profile for the agent graph (sourced by agent-graph.sh and by the Orca precheck).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
# 值来源见 ONBOARD.md 第 1-3 步。install.sh 会校验前 9 个变量与 AGENT_TIER_DEFAULT 非空、三档格式（两个冒号），并核对 Linear 标签/项目 ID 真实存在。

AGENT_GH_REPO=vmxmy/orca-factory                             # GitHub 仓库（依据：git remote get-url origin）
AGENT_LINEAR_TEAM=c91047bb-0579-4b53-b1eb-ad8fba454e16       # ZII（Ziikoo）；orca linear team list --json → .result.teams[].id
AGENT_LINEAR_PROJECT=480a07e8-8b39-4b8f-92b9-dbf1997cbd8c    # orca-factory；与仓库同名的 Linear project（the repo fence）；orca linear project list --json
AGENT_LABEL_READY=3ca28041-4db1-478b-a3d9-a3ab9a32bfe4       # ready-for-agent；orca linear team labels --team ZII --json
AGENT_LABEL_CLAIMED=c5d24f03-3e01-46f0-9807-a1831afa1815     # auto-impl
AGENT_LABEL_FAILED=5feda890-12d4-43de-b5ab-02bd2d9a4b49      # auto-failed
AGENT_MAX_IN_FLIGHT=10                                       # 同时在途票上限（依据：用户答复，2026-10-05 由 4 调为 10）
AGENT_BATCH_SIZE=0                                           # 单次运行最多新领票数；0=不设上限，由 AGENT_MAX_IN_FLIGHT − 在途数 兜底（依据：用户答复）
AGENT_SCOPE_AVOID=0                                          # 0=precheck 不做 SCOPE 过滤，并行冲突由合并阶段 workflow §2 的 rebase 规则兜底（依据：用户答复）
AGENT_STALE_HOURS=8   # in-flight ticket with no Linear update for this long -> precheck flips it to auto-failed
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-            # Orca 定时任务 worktree 名前缀，prune-run-worktrees.sh 据此清理；一般不改
AGENT_INSTALL_CMD='true'                                     # 本仓库无依赖可装（无 package.json / 锁文件；依据：仓库文件清单、用户答复）
AGENT_DEPLOY_WORKFLOW=''                                     # 无自动部署（无 .github/；依据：用户答复）
AGENT_SMOKE_CMD=''                                           # 无自动部署，不冒烟
# Model tiers (ONBOARD 第 1 步「角色后端」行、第 3 步问答). 格式 agent:model:effort；coordinator 按 workflow.md §6 解析后拆成
# worker-start --agent/--model/--effort。model 可空（codex::low = 该 agent 的默认模型，此时 --model/--effort 都不传）。
AGENT_TIER_FAST='codex:gpt-6-astra:low'        # agent:model:effort；model 可空（codex::low = 该 agent 默认模型）
AGENT_TIER_DEFAULT='codex:gpt-6-astra:medium'
AGENT_TIER_STRONG='codex:gpt-6.1-sol:high'
AGENT_TIER_ESCALATE=1                           # 1=被打回一次后下一轮 correction 自动升一档；0=不升
AGENT_TIER_BY_ESTIMATE='1-2:fast 3-5:default 8-:strong'   # Linear estimate → 档位；无 estimate 用 default
AGENT_ROLE_REVIEWER_CMD='env -u ORCA_PANE_KEY -u ORCA_AGENT_HOOK_PORT -u ORCA_AGENT_HOOK_TOKEN claude -p --model claude-opus-5-5 --effort medium --permission-mode dontAsk --allowedTools "Read Grep Glob Bash(git diff:*) Bash(git status:*) Bash(git log:*)"'   # lane 2 异构审查命令，在单元 worktree 内执行，roles/reviewer.md + 简报经 stdin 传入；可空=不做
AGENT_ROLE_REVIEWER_CMD_SMALL='env -u ORCA_PANE_KEY -u ORCA_AGENT_HOOK_PORT -u ORCA_AGENT_HOOK_TOKEN claude -p --model claude-sonnet-5-5 --effort high --permission-mode dontAsk --allowedTools "Read Grep Glob Bash(git diff:*) Bash(git status:*) Bash(git log:*)"'
AGENT_REVIEWER_SMALL_MAX_ESTIMATE=2
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (automerge follows AGENT_LANE2_AUTOMERGE and manual globs).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
# LANE2：流水线本体（core/ bin/ templates/ ONBOARD.md .claude-plugin/ mods/，会分发到所有接入仓库）+ agent 配置 + CI（依据：用户答复）。
AGENT_LANE2_GLOBS='driver/* core/* bin/* templates/* ONBOARD.md .claude-plugin/* mods/* .github/* .claude/* .codex/* AGENTS.md CLAUDE.md scripts/agent-gates/*' # driver 纳入 lane 2（依据：ZII-845）
# LANE3：密钥/环境变量文件、部署工作流（本仓库当前都没有，预留）。
AGENT_LANE3_GLOBS='.env* *secrets*'   # 只保留密钥类文件为 lane 3；部署工作流按 lane 2 自动合并（依据：用户答复，2026-10-05）
AGENT_LANE2_AUTOMERGE=1                         # 本仓库 lane 2 满足复核、CI 与路径条件后默认自合
AGENT_LANE2_MANUAL_GLOBS=''   # 空格分隔 bash glob，* 跨 /；为空表示 lane 2 全部在复核、审查与 CI 通过后自动合并（依据：用户答复，2026-10-05 授权所有合并自主完成）
