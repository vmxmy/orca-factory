# Project profile for the agent graph (sourced by agent-graph.sh and by orca-factory-driver).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
# 值来源见 ONBOARD.md 第 1-3 步。install.sh 会校验必填变量非空、三档格式（两个冒号），并按所选账本验证票据访问。

AGENT_GH_REPO=vmxmy/orca-factory                             # GitHub 仓库，代码托管与合并（依据：git remote get-url origin）
AGENT_ISSUE_BACKEND=feishu                                 # 唯一执行账本（依据：用户批准的飞书生产切换，2026-10-15；此前为 github）
AGENT_FEISHU_BASE=https://qcnqhljeakpl.feishu.cn/base/VeQObWd9VaV66tsiM7GcN0Avnph   # 生产 Base「orca-factory 研发票据账本」
AGENT_FEISHU_PROJECT=github.com/vmxmy/orca-factory         # 项目表“仓库远端”
AGENT_MAX_IN_FLIGHT=20                                       # 同时在途票上限（依据：用户答复，2026-10-05 由 4 调为 10；2026-10-06 内存用约 45%、实测每票约 1GB，由 10 调为 20）
AGENT_SCOPE_AVOID=0                                          # 0=driver 不做 SCOPE 过滤，并行冲突由合并阶段 workflow §2 的 rebase 规则兜底（依据：用户答复）
AGENT_STALE_HOURS=8   # 在途票超过此时长无票据更新 -> driver 判为陈旧
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-            # Orca 定时任务 worktree 名前缀，prune-run-worktrees.sh 据此清理；一般不改
AGENT_INSTALL_CMD='true'                                     # 本仓库无依赖可装（无 package.json / 锁文件；依据：仓库文件清单、用户答复）
AGENT_DEPLOY_WORKFLOW=''                                     # 无部署 workflow；driver 自部署（OF-152）
AGENT_SELF_DEPLOY=1                                          # 合并后 serve 在部署屏障中构建并安装 squash SHA 的 driver、重启自身（OF-152，负责人选方案 1）
AGENT_SMOKE_CMD='"$HOME/.local/bin/orca-factory-driver" doctor >/dev/null'   # 自部署冒烟：doctor 无 fail；版本等于 squash SHA 由 driver 先行核对
# Model tiers (ONBOARD 第 1 步「角色后端」行、第 3 步问答). 格式 agent:model:effort；coordinator 按 workflow.md §6 解析后拆成
# worker-start --agent/--model/--effort。model 可空（codex::low = 该 agent 的默认模型，此时 --model/--effort 都不传）。
# 档位按 ~/.agents/pstack-models.md：feature/bug-fix=sonnet@high，hardest tasks=opus@high；审查按其 codex 段 trail reviewer=gpt-6-astra@high（跨模型独立审查）
AGENT_TIER_FAST='claude:claude-sonnet-5-5:high'        # agent:model:effort；model 可空（codex::low = 该 agent 默认模型）
AGENT_TIER_DEFAULT='claude:claude-sonnet-5-5:high'
AGENT_TIER_STRONG='claude:claude-opus-5-5:high'
AGENT_TIER_ESCALATE=1                           # 1=被打回一次后下一轮 correction 自动升一档；0=不升
AGENT_TIER_BY_ESTIMATE='1-2:fast 3-5:default 8-:strong'   # 票据 estimate → 档位；无 estimate 用 default
AGENT_ROLE_REVIEWER_CMD='env -u ORCA_PANE_KEY -u ORCA_AGENT_HOOK_PORT -u ORCA_AGENT_HOOK_TOKEN codex exec -m gpt-6-astra -c model_reasoning_effort=high --sandbox read-only -'   # lane 2 审查命令，在单元 worktree 内执行，roles/reviewer.md + 简报经 stdin 传入；可空=不做
AGENT_ROLE_REVIEWER_CMD_SMALL='env -u ORCA_PANE_KEY -u ORCA_AGENT_HOOK_PORT -u ORCA_AGENT_HOOK_TOKEN codex exec -m gpt-6-astra -c model_reasoning_effort=high --sandbox read-only -'
AGENT_REVIEWER_SMALL_MAX_ESTIMATE=2
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (automerge follows AGENT_LANE2_AUTOMERGE and manual globs).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
# LANE2：流水线本体（core/ bin/ templates/ ONBOARD.md，会分发到所有接入仓库）+ agent 配置 + CI（依据：用户答复）。
AGENT_LANE2_GLOBS='driver/* core/* bin/* templates/* ONBOARD.md .github/* .claude/* .codex/* AGENTS.md CLAUDE.md scripts/agent-gates/*' # driver 纳入 lane 2（依据：ZII-845）
# LANE3：密钥/环境变量文件、部署工作流（本仓库当前都没有，预留）。
AGENT_LANE3_GLOBS='.env* *secrets*'   # 只保留密钥类文件为 lane 3；部署工作流按 lane 2 自动合并（依据：用户答复，2026-10-05）
AGENT_LANE2_AUTOMERGE=1                         # 本仓库 lane 2 满足复核、CI 与路径条件后默认自合
AGENT_LANE2_MANUAL_GLOBS=''   # 空格分隔 bash glob，* 跨 /；为空表示 lane 2 全部在复核、审查与 CI 通过后自动合并（依据：用户答复，2026-10-05 授权所有合并自主完成）
