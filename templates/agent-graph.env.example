# Project profile for the agent graph (sourced by agent-graph.sh and by the Orca precheck).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
# 填法：把每个 {{...}} 换成实际值，保留行尾注释里的人类可读名字，方便复核。值含空格或 $ 时用单引号。
# 值来源见 ONBOARD.md 第 1-3 步。install.sh 会校验前 9 个变量非空，并核对 Linear 标签/项目 ID 真实存在。

AGENT_GH_REPO={{owner/repo}}                                 # GitHub 仓库，形如 vmxmy/zhiyun-ai-dashboard（gh api 用）
AGENT_LINEAR_TEAM={{linear-team-uuid}}                       # {{TEAM_KEY}}；orca linear team list --json → .result.teams[].id
AGENT_LINEAR_PROJECT={{linear-project-uuid}}                 # {{project-name}}；与仓库同名的 Linear project（the repo fence）；orca linear project list --json
AGENT_LABEL_READY={{label-uuid}}                             # ready-for-agent；orca linear team labels --team <TEAM> --json
AGENT_LABEL_CLAIMED={{label-uuid}}                           # auto-impl
AGENT_LABEL_FAILED={{label-uuid}}                            # auto-failed
AGENT_MAX_IN_FLIGHT={{2}}                                    # 同时在途票上限（第 3 步问答；默认 2）
AGENT_STALE_HOURS=4   # in-flight ticket with no Linear update for this long -> precheck flips it to auto-failed
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-            # Orca 定时任务 worktree 名前缀，prune-run-worktrees.sh 据此清理；一般不改
AGENT_INSTALL_CMD='{{pnpm install --frozen-lockfile}}'        # 工人在新 worktree 里装依赖的命令，原样写进每份 task spec（第 1 步推导，第 3 步确认）
AGENT_DEPLOY_WORKFLOW='{{Deploy}}'                           # .github/workflows 里部署工作流的 name:（合并后 coordinator 等它成功）；无自动部署留空 ''
AGENT_SMOKE_CMD='{{[ "$(curl -s -o /dev/null -w %{http_code} https://example.com/)" = 200 ]}}'   # 部署后冒烟，退出 0 即通过；无自动部署留空 ''
# Role backends (ONBOARD 第 1 步「角色后端」行). COORDINATOR.md 第 2 步派工与第 3 步复核读这三项。
AGENT_ROLE_WORKER_AGENT=codex          # worker-start --agent；Orca 里启用的 agent id（codex / claude / …），默认 codex
AGENT_ROLE_WORKER_MODEL=               # 可空；非空则 worker-start 加 --model <id>
AGENT_ROLE_REVIEWER_CMD='codex exec review --base origin/main --json'   # lane 2 异构审查命令，在单元 worktree 内执行，roles/reviewer.md + 简报经 stdin 传入；可空=不做
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (PR not self-merged).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
# LANE2 建议至少包含：CI/基础设施（.github/*）、契约/类型、权限/会话、迁移、依赖清单（package.json 等）、agent 配置（AGENTS.md CLAUDE.md .claude/* .codex/*）。
AGENT_LANE2_GLOBS='{{.github/* package.json AGENTS.md CLAUDE.md .claude/* .codex/* scripts/agent-gates/*}}'
# LANE3 建议：密钥/环境变量文件、部署脚本与部署工作流。
AGENT_LANE3_GLOBS='{{.env* .github/workflows/deploy*}}'
