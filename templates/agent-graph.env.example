# Project profile for the agent graph (sourced by agent-graph.sh and by the Orca precheck).
# Everything project-specific lives here or in gate.project.sh / COORDINATOR.project.md.
# 填法：把每个花括号占位换成实际值，保留行尾注释里的人类可读名字，方便复核。值含空格或 $ 时用单引号。
# 值来源见 ONBOARD.md 第 1-3 步。install.sh 会校验前 9 个变量与 AGENT_TIER_DEFAULT 非空、三档格式（两个冒号），并核对 Linear 标签/项目 ID 真实存在。

AGENT_GH_REPO={{owner/repo}}                                 # GitHub 仓库，形如 vmxmy/zhiyun-ai-dashboard（gh api 用）
AGENT_LINEAR_TEAM={{linear-team-uuid}}                       # {{TEAM_KEY}}；orca linear team list --json → .result.teams[].id
AGENT_LINEAR_PROJECT={{linear-project-uuid}}                 # {{project-name}}；与仓库同名的 Linear project（the repo fence）；orca linear project list --json
AGENT_LABEL_READY={{label-uuid}}                             # ready-for-agent；orca linear team labels --team <TEAM> --json
AGENT_LABEL_CLAIMED={{label-uuid}}                           # auto-impl
AGENT_LABEL_FAILED={{label-uuid}}                            # auto-failed
AGENT_MAX_IN_FLIGHT={{2}}                                    # 同时在途票上限（第 3 步问答；默认 2）
AGENT_BATCH_SIZE=1                                           # 单次运行最多新领票数（正整数为上限；0=不设上限，由 AGENT_MAX_IN_FLIGHT − 在途数 兜底）；需 precheck 支持
AGENT_SCOPE_AVOID=1                                          # 1=precheck 按 SCOPE 排除与在途票重叠的候选（默认，稳健）；0=precheck 不做任何 SCOPE 过滤，并行冲突交给合并阶段 workflow §2 的 rebase 规则
AGENT_STALE_HOURS=8   # in-flight ticket with no Linear update for this long -> precheck flips it to auto-failed
AGENT_RUN_WORKTREE_PREFIX=auto-agent-linear-scan-            # Orca 定时任务 worktree 名前缀，prune-run-worktrees.sh 据此清理；一般不改
AGENT_INSTALL_CMD='{{pnpm install --frozen-lockfile}}'        # 工人在新 worktree 里装依赖的命令，原样写进每份 task spec（第 1 步推导，第 3 步确认）
AGENT_DEPLOY_WORKFLOW='{{Deploy}}'                           # .github/workflows 里部署工作流的 name:（合并后 coordinator 等它成功）；无自动部署留空 ''
AGENT_SMOKE_CMD='{{[ "$(curl -s -o /dev/null -w %{http_code} https://example.com/)" = 200 ]}}'   # 部署后冒烟，退出 0 即通过；无自动部署留空 ''
# 可选飞书通知配置：留空表示不接飞书；暂时只记录配置，coordinator 发通知由后续票完成。
AGENT_NOTIFY_FEISHU_PROFILE=''                 # 机器级机器人 profile，接入时默认 orca-factory
AGENT_NOTIFY_FEISHU_CHAT=''                    # 本项目专属通知群 ID，每个项目一个群
# Model tiers (ONBOARD 第 1 步「角色后端」行、第 3 步问答). 格式 agent:model:effort；coordinator 按 workflow.md §6 解析后拆成
# worker-start --agent/--model/--effort。model 可空（codex::low = 该 agent 的默认模型，此时 --model/--effort 都不传）。
AGENT_TIER_FAST='codex:gpt-6-astra:low'        # agent:model:effort；model 可空（codex::low = 该 agent 默认模型）
AGENT_TIER_DEFAULT='codex:gpt-6-astra:medium'
AGENT_TIER_STRONG='codex:gpt-6.1-sol:high'
AGENT_TIER_ESCALATE=1                           # 1=被打回一次后下一轮 correction 自动升一档；0=不升
AGENT_TIER_BY_ESTIMATE='1-2:fast 3-5:default 8-:strong'   # Linear estimate → 档位；无 estimate 用 default
AGENT_ROLE_REVIEWER_CMD='codex exec --json'   # lane 2 异构审查命令，在单元 worktree 内执行，roles/reviewer.md + 简报经 stdin 传入；可空=不做
# Lane globs: space-separated bash globs matched by gate.sh ([[ $f == $g ]], '*' spans '/').
# A changed file matching LANE3 -> gate red (never automated); matching LANE2 -> LANE 2 (automerge is opt-in; see AGENT_LANE2_AUTOMERGE).
# scripts/agent-gates/* is always lane 2 (hard-coded in gate.sh).
# LANE2 建议至少包含：CI/基础设施（.github/*）、契约/类型、权限/会话、迁移、依赖清单（package.json 等）、agent 配置（AGENTS.md CLAUDE.md .claude/* .codex/*）。
AGENT_LANE2_GLOBS='{{.github/* package.json AGENTS.md CLAUDE.md .claude/* .codex/* scripts/agent-gates/*}}'
# LANE3 建议：密钥/环境变量文件、部署脚本与部署工作流。
AGENT_LANE3_GLOBS='{{.env* .github/workflows/deploy*}}'
AGENT_LANE2_AUTOMERGE=0                         # 1=lane 2 满足复核、CI 与路径条件后自合；0=转人（默认）
AGENT_LANE2_MANUAL_GLOBS=''                      # 空格分隔 bash glob，与 gate.sh 的 match_any 一致，* 跨 /；scripts/agent-gates/* 始终转人
